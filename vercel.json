{
    "version": 2,
    "builds": [
        {
            "src": "backend/app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "frontend/styles.css",
            "use": "@vercel/static"
        },
        {
            "src": "frontend/app.js",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/docs",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/openapi.json",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/health",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/styles.css",
            "destination": "/frontend/styles.css"
        },
        {
            "source": "/app.js",
            "destination": "/frontend/app.js"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}